aws_region         = "eu-west-1"
project_name       = "ai-dev-lifecycle"
environment        = "dev"
cluster_name       = "ai-dev-lifecycle-eks"
kubernetes_version = "1.33"

availability_zones   = ["eu-west-1a", "eu-west-1b"]
public_subnet_cidrs  = ["10.40.0.0/24", "10.40.1.0/24"]
private_subnet_cidrs = ["10.40.10.0/24", "10.40.11.0/24"]

# Replace with your real office/VPN public egress CIDR.
eks_api_public_access_cidrs = ["203.0.113.10/32"]

node_instance_types = ["m6i.large"]
node_desired_size   = 2
node_min_size       = 2
node_max_size       = 4

# Replace wildcard with the approved Bedrock model/inference-profile ARN(s).
bedrock_model_arns = ["*"]
# artifact_bucket_name = "globally-unique-artifact-bucket-name"
